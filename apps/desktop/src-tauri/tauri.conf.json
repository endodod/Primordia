{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Primordia",
  "version": "0.0.0",
  "identifier": "io.github.endodod.primordia",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Primordia Lab", "width": 1000, "height": 700 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
